# 复制为 .env 后用 `set -a; . ./.env; set +a; node server/server.js` 启动
PORT=8000
DB_PATH=./server/data.db
SIGNUP_BONUS=100
# 生产环境留空/不要设置；仅本地调试用，开启后「充值」会直接到账
ALLOW_DEMO_TOPUP=0
# 支付网关：创建订单后跳转的收银台地址，{orderId} {price} 会被替换
PAY_URL_TEMPLATE=
# 支付网关回调 POST /api/billing/webhook 的 HMAC-SHA256 密钥（头 x-signature = hex(hmac(body))）
PAY_WEBHOOK_SECRET=
# 真实模型：在 server/models.json 里配置，Key 通过环境变量注入，例如 OPENAI_KEY
OPENAI_KEY=
